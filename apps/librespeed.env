# LibreSpeed's binary. Each KEY=value line, unquoted and with no comment
# after it, is one build argument: `just build-app librespeed` and the build
# workflow pass every one, and the app's name as APP.

# Only the extensions LibreSpeed and its bootstrap need. pdo_sqlite cannot
# be built without sqlite3, so the binary carries both.
PHP_EXTENSIONS=ctype,filter,openssl,phar,pdo,pdo_sqlite,sqlite3,session,gd,zlib,pcntl,posix,opcache
# watcher is FrankenPHP's file watcher. freetype and libpng are what gd
# needs to draw the share image's text and write it as a PNG. spc builds
# both already, freetype as one of gd's suggestions and libpng as a
# dependency, so naming them here keeps the share image working if spc ever
# stops. craft.yml's with-suggests stays on, so gd still brings its
# suggested codecs, libavif among them. build-static.sh appends brotli,
# which caddy-cbrotli needs.
PHP_EXTENSION_LIBS=watcher,freetype,libpng
# Every module the binary loads, in lower case: the extensions above plus
# the modules every PHP 8.5 build and FrankenPHP carry
EXPECTED_EXTENSIONS=core,ctype,date,filter,frankenphp-cli,gd,hash,json,lexbor,opcache,openssl,pcntl,pcre,pdo,pdo_sqlite,phar,posix,random,reflection,session,spl,sqlite3,standard,uri,zlib
# results/index.php draws the share image with imagefttext() and imagepng().
# The codecs spc's suggestions add are not checked either way.
REQUIRED_GD_FEATURES=FreeType Support,PNG Support
