# Baikal's binary. Each KEY=value line, unquoted and with no comment after
# it, is one build argument: `just build-app baikal` and the build workflow
# pass every one, and the app's name as APP.

# The twenty extensions Baikal needs
PHP_EXTENSIONS=dom,pdo,pdo_sqlite,sqlite3,zlib,mbstring,mbregex,iconv,session,xml,xmlreader,xmlwriter,simplexml,filter,tokenizer,ctype,pcntl,posix,opcache,openssl
# watcher is FrankenPHP's file watcher. This replaces craft.yml's extra
# libraries, whose libavif, nghttp2/3 and ngtcp2 serve extensions this build
# leaves out. build-static.sh appends brotli, which caddy-cbrotli needs.
PHP_EXTENSION_LIBS=watcher
# Every module the binary loads, in lower case: the twenty above less
# mbregex, which is part of mbstring, plus libxml, which dom and the xml
# extensions bring, and the modules every PHP 8.5 build and FrankenPHP carry
EXPECTED_EXTENSIONS=core,ctype,date,dom,filter,frankenphp-cli,hash,iconv,json,lexbor,libxml,mbstring,opcache,openssl,pcntl,pcre,pdo,pdo_sqlite,posix,random,reflection,session,simplexml,spl,sqlite3,standard,tokenizer,uri,xml,xmlreader,xmlwriter,zlib
# Baikal has no gd
REQUIRED_GD_FEATURES=
